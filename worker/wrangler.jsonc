{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ptt-notify",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // 檢查頻率（UTC cron），最短每分鐘
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ptt-notify",
      // npx wrangler d1 create ptt-notify 的輸出
      "database_id": "056a03ed-4a4b-4506-b414-93610b7d0ea8",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
